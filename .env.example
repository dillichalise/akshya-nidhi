# Neon pooled connection string (Vercel Marketplace sets DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random string, at least 32 chars:  openssl rand -base64 48
SESSION_SECRET=
# Used only by `npm run db:seed` to create the first super_admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Super Admin

# PostHog — session recording & analytics (optional; leave blank to disable)
# Find these in PostHog → Project Settings → Project API Keys
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Overall fundraising target for the event (NPR, integer). Defaults to 1000000 if unset.
EVENT_TARGET_AMOUNT=1000000
